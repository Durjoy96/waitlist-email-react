{
  "name": "waitlist-email-react",
  "version": "0.1.0",
  "description": "A dead-simple waitlist email collection form/client for self-hosted waitlist-email instances.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "waitlist",
    "email",
    "signup",
    "nextjs",
    "react",
    "saas"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesOptional": {
    "react": true
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Durjoy96/waitlist-email-react.git"
  },
  "homepage": "https://github.com/Durjoy96/waitlist-email-react"
}
